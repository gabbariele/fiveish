# --- Server ---
PORT=8787
# Origini extra ammesse dal CORS (separate da virgola). Il dev server Vite e' gia' incluso.
CORS_ORIGINS=

# --- Provider prezzi ---
# sample  -> dataset dimostrativo incluso, funziona offline (prezzi sintetici)
# amadeus -> prezzi reali via Amadeus Self-Service API (serve una API key gratuita)
PROVIDER=sample

# Credenziali Amadeus (https://developers.amadeus.com -> My Self-Service Workspace)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# test = ambiente sandbox gratuito, production = dati live (richiede upgrade dell'app)
AMADEUS_ENV=test

# --- Motore offerte ---
# Punteggio minimo (0-100) per considerare un'offerta "super". Sotto questa soglia non viene mostrata.
MIN_DEAL_SCORE=72
# Sconto minimo sul prezzo di riferimento calcolato da noi (0-1).
MIN_DISCOUNT=0.30
# Tetto di prezzo a notte: oltre questo importo nulla e' un affare, per quanto scontato.
MAX_NIGHTLY_PRICE=1200

# --- Scansione automatica ---
# Minuti fra una scansione e l'altra. 0 = disattivata (solo scansioni manuali).
SCAN_INTERVAL_MINUTES=180
SCAN_ON_BOOT=true

# --- Funzioni assistite da Gemini (facoltative) ---
# Senza chiave l'app funziona identica: resta la ricerca a filtri al posto di
# quella a frase libera, e le note sulle destinazioni non compaiono.
# Chiave gratuita su https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=8000

# --- Avvisi ---
# Webhook (Slack / Telegram / n8n / Zapier...) su cui inviare le nuove super offerte.
ALERT_WEBHOOK_URL=
